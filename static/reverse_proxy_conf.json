{
    "example_config_1" : {
        "listener": "127.0.0.1:8080",
        "worker_count": 5,
        "backends" : [
            {
                "name": "backend_1",
                "host": "homeassistant.local",
                "hostname": "homeassistant.local",
                "port": 32400
            },
            {
                "name": "backend_2",
                "host": "speedcheck.org",
                "hostname": "speedcheck.org",
                "port": 443,
                "https": true 
            }
        ],
        "proxy_rules": [
            {
                "type": "proxy_rule_host",
                "from": "127.0.0.1:8080",
                "to": "backend_1"
            },
            {
                "type": "proxy_rule_host",
                "from": "0.0.0.0:8080",
                "to": "backend_1"
            },
            {
                "type": "proxy_rule_host",
                "from": "localhost:8080",
                "to": "backend_2"
            }
        ]
    },
    "example_config_2" : { 
        "listener": "127.0.0.1:8081",
        "worker_count": 1,
        "backends" : [
            {
                "name": "backend_1",
                "host": "localhost",
                "hostname": "testwebsite.com",
                "port": 8000
            }
        ],
        "proxy_rules": [
            {
                "type": "proxy_rule_host",
                "from": "127.0.0.1:8081",
                "to": "backend_1"
            }
        ]
    }   
}
